{
  "name": "meetgrid",
  "version": "1.0.0",
  "private": true,
  "description": "Dead-simple no-login scheduling polls (Doodle alternative)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply meetgrid-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meetgrid-db --remote",
    "typecheck": "tsc --noEmit",
    "test:dst": "npx --yes tsx scripts/test-dst.ts",
    "test:expiry": "npx --yes tsx scripts/test-expiry.ts",
    "test:calendar": "npx --yes tsx scripts/test-calendar.ts",
    "test:email": "npx --yes tsx scripts/test-email.ts",
    "test": "npm run test:dst && npm run test:calendar && npm run test:email",
    "mcp:build": "npm run build --prefix mcp",
    "mcp:start": "node mcp/dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.7.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.1.0"
  }
}
